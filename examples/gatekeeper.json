{
  "listen": ":8080",
  "admin": ":9090",
  "log_level": "info",
  "shutdown_timeout": "15s",
  "routes": [
    {
      "name": "echo",
      "path_prefix": "/echo",
      "upstreams": ["http://127.0.0.1:8081", "http://127.0.0.1:8082"],
      "strip_prefix": true,
      "rate_limit": { "rps": 5, "burst": 10, "idle_timeout": "5m" },
      "timeout": "5s",
      "circuit_breaker": { "failure_threshold": 3, "cooldown": "20s" }
    },
    {
      "name": "httpbin",
      "path_prefix": "/httpbin",
      "upstreams": ["https://httpbin.org"],
      "strip_prefix": true,
      "timeout": "10s"
    }
  ]
}
